// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// VolQuant — native realtime quant engine persistence.
// Snapshots of computed dealer-positioning metrics (GEX history / stress
// history / OI history) and the persisted options tape, so analytics have
// true time depth across restarts (our own data, computed live from Deribit).
// ─────────────────────────────────────────────────────────────────────────────

model QuantSnapshot {
  id                String   @id @default(cuid())
  symbol            String // BTC | ETH
  ts                DateTime
  spot              Float
  totalGexUsd1pct   Float // net dealer gamma exposure, USD per 1% spot move
  callGexUsd1pct    Float
  putGexUsd1pct     Float
  hvl               Float? // gamma-flip (high volatility level)
  callWall          Float?
  putSupport        Float?
  maxPain           Float?
  atmIv30           Float? // our own constant-maturity 30d ATM IV (annualized %)
  totalOiContracts  Float // options open interest in underlying contracts
  totalOiNotionalUsd Float
  putCallRatioOi    Float
  perpOiUsd         Float? // aggregated perp OI across venues
  fundingRate       Float?
  dataJson          String? // compact extras (top strikes, per-expiry gex…)

  @@index([symbol, ts])
}

model OptionTrade {
  id          String   @id // venue trade id (dedupe key)
  symbol      String // BTC | ETH
  ts          DateTime
  instrument  String
  strike      Float
  expiry      String // ISO date
  isCall      Boolean
  side        String // taker side: buy | sell
  premiumUsd  Float
  amount      Float // contracts (underlying units)
  iv          Float? // implied vol at trade (annualized %)
  indexPrice  Float
  venue       String @default("deribit")

  @@index([symbol, ts])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDER FLOW / FORECAST — analytics storage ("store now, analyze later").
//
// The order-flow engine's own 1-minute flow bars (multi-venue truth), the
// conformal forecast runs that consumed them, their cross-validated
// evaluations, and periodic microstructure snapshots: SQLite rows that
// outlive dev-server restarts, so later analytics (coverage drift, regime
// studies, backtests against recorded flow) have real time depth.
// ─────────────────────────────────────────────────────────────────────────────

model FlowBar {
  id       String   @id @default(cuid())
  asset    String // BTC | ETH | SOL | XRP | BNB | DOGE | LINK | AVAX
  tfSec    Int // bar timeframe in seconds (60 = 1 m engine bars)
  tOpen    DateTime // bar open time
  open     Float
  high     Float
  low      Float
  close    Float
  volume   Float // base units traded across all venues
  buyVol   Float
  sellVol  Float
  delta    Float // buyVol - sellVol
  trades   Int
  cvd      Float // session cumulative delta at bar close
  oi       Float? // summed open interest at bar close (base units)

  @@unique([asset, tfSec, tOpen])
  @@index([asset, tfSec, tOpen])
}

model ForecastRun {
  id            String   @id @default(cuid())
  asset         String
  tfSec         Int
  target        String // close | volume | delta | cvd | …
  h             Int // horizon steps
  levelsJson    String // [80, 95]
  nWindows      Int // conformal calibration windows W
  cutoff        DateTime // last observation the forecast conditioned on
  anchor        Float // panel close at cutoff
  expectedMove  Float? // |median(h) - anchor|
  bandJson      String // compact per-model per-level bounds: model → level → [lo, hi] at h
  modelsJson    String // per-model summary rows (point path + widths)
  provenance    String // engineBars | klinesBars | engineOnly
  createdAt     DateTime @default(now())

  @@index([asset, target, tfSec, createdAt])
}

model ForecastEvalRun {
  id          String   @id @default(cuid())
  asset       String
  tfSec       Int
  target      String
  h           Int
  levelsJson  String
  cvWindows   Int
  rowsJson    String // FcEvaluateRow[] — coverage/width/MASE/sCRPS/clamp per model
  perStepJson String? // per-step coverage of the primary model
  createdAt   DateTime @default(now())

  @@index([asset, target, tfSec, createdAt])
}

model MicroSnapshot {
  id          String   @id @default(cuid())
  asset       String
  ts          DateTime
  price       Float
  // advanced microstructure (nullable = too-young session)
  kyleLambda  Float? // bps price impact per $100k aggressor flow
  vpin        Float?
  amihud      Float? // bps per $1M traded
  signAutocorr Float?
  microSkew   Float? // microprice skew
  obi         Float? // mean OBI(±10bp) over the last minute
  rvAnnPct    Float? // close-to-close realized vol (annualized %)
  atrPct      Float?
  volRegime   String? // compressed | normal | elevated | extreme
  vwapDist    Float? // σ units
  takerShare  Float? // 1 m aggressor buy share
  volumeZ     Float?
  cvd1m       Float?
  depth10Bp   Float? // resting base units within ±10 bp (bids+asks)
  spreadBps   Float?
  absorption15m Int // confirmed markers in the last 15 m
  iceberg15m  Int

  @@index([asset, ts])
}

// ─────────────────────────────────────────────────────────────────────────────
// HISTORICAL BACKFILL — venue REST history mirrored into SQLite so analytics
// survive restarts and never re-hit exchange rate limits ("store now, analyze
// later" — the backfill worker writes here once; panels read from here first).
//
//   KlineBar        exchange klines incl. taker-buy base volume (the same
//                   aggressor semantics as our engine delta)
//   DerivativesPoint funding-rate & open-interest history (venue polls are
//                   depth-limited: funding ~full depth, OI ~30 days)
// ─────────────────────────────────────────────────────────────────────────────

model KlineBar {
  id        String   @id @default(cuid())
  venue     String // binance | bybit | okx | …
  asset     String // BTC | ETH | SOL | …
  tfSec     Int // bar timeframe in seconds
  tOpen     DateTime // bar open time (UTC, venue-aligned)
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float // base units
  buyVolume Float // taker-buy base units (aggressor buy)
  trades    Int // print count in the bar

  @@unique([venue, asset, tfSec, tOpen])
  @@index([asset, tfSec, tOpen])
}

model DerivativesPoint {
  id     String   @id @default(cuid())
  venue  String // binance | bybit | okx | …
  asset  String
  kind   String // funding | openInterest
  ts     DateTime // observation time (UTC)
  value  Float // funding rate as 8h fraction (0.0001 = 1bp/8h) or OI base units

  @@unique([venue, asset, kind, ts])
  @@index([asset, kind, ts])
}

// Backfill worker bookkeeping — one row per finished job chunk so restarts
// know exactly where history left off (idempotent resume).
model BackfillJob {
  id        String   @id @default(cuid())
  venue     String
  asset     String
  kind      String // klines:60 | funding | oi:300 …
  from      DateTime // chunk start
  to        DateTime // chunk end
  rows      Int // rows written (upserted) by the chunk
  ms        Int // wall time of the chunk fetch+write
  note      String? // e.g. "418 backoff 61s" on throttled chunks

  @@index([venue, asset, kind, to])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRACK B — SIGNAL RESEARCH HARNESS.
// Every factor backtest run over the stored history is persisted here: the
// universe it saw (asset, tf, horizon, window), per-factor statistics (IC,
// hit rate, quintile spread, t-stats) and the composite row — so the Copilot
// and the UI can quote research results that survive restarts, and repeated
// runs form a track record of *which factors actually worked, when*.
// ─────────────────────────────────────────────────────────────────────────────

model ResearchRun {
  id           String   @id @default(cuid())
  asset        String
  tfSec        Int // bar timeframe the factors consumed (300 = 5m)
  horizonBars  Int // forward-return horizon in bars
  lookbackDays Int // history window evaluated
  venue        String // kline source venue (binance)
  bars         Int // bars actually scored
  factorsJson  String // FactorResult[] — full per-factor stats
  compositeJson String // composite factor stats
  createdAt    DateTime @default(now())

  @@index([asset, tfSec, horizonBars, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONVERSATION MEMORY (RAG substrate).
// Every copilot/deep-research turn is persisted: the user asks, the desk
// answers. Messages are embedded (hashing vectorizer, optionally remote)
// so later turns can retrieve relevant past exchanges and the copilot
// REMEMBERS prior conclusions across sessions and reloads.
// ─────────────────────────────────────────────────────────────────────────────

model ConversationSession {
  id        String   @id @default(cuid())
  title     String? // first user message, truncated
  kind      String   @default("chat") // chat | research
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ConversationMessage[]

  @@index([updatedAt])
}

model ConversationMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant | research
  content   String
  embedding String? // base64-packed Float32 hashing-vector embedding
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}
