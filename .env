DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── AI providers (put real SECRETS in .env.local, which is git-ignored) ───────
# OmniRoute gateway (https://github.com/cheaper-inference/OmniRoute) — 375+
# providers behind one OpenAI-compatible /v1 endpoint, quota-aware fallback:
#   OMNIROUTE_API_KEY=...        # activates OmniRoute as the primary backend
#   OMNIROUTE_BASE_URL=https://omniroute.online/v1   # or http://localhost:20128/v1 (self-host)
#   OMNIROUTE_MODEL=auto         # 'auto' | 'auto/cheap' | 'openai/gpt-…' | 'glm/glm-…'
# Any other OpenAI-compatible gateway (OpenRouter/LiteLLM/vLLM/Ollama):
#   OPENAI_COMPAT_BASE_URL=...  OPENAI_COMPAT_API_KEY=...  OPENAI_COMPAT_MODEL=...
# Force a backend: AI_PROVIDER=auto | omniroute | zai
# Without a gateway the desk runs on the built-in GLM backend; with one, GLM
# is the automatic failover (circuit breaker: 3 failures → 5 min cooldown).
